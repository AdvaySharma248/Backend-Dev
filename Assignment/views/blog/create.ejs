<!-- create blog post ka heading -->
<h1>Create New Blog Post</h1>

<!-- agar error hai to dikhao // error message -->
<% if (error) { %>
    <div>
        <p><%= error %></p>
    </div>
<% } %>

<!-- blog post create form // create form -->
<form method="POST" action="/blog">
    <!-- title field container -->
    <div>
        <label for="title">Title:</label>
        <input type="text" id="title" name="title" required>
    </div>
    
    <!-- author field container -->
    <div>
        <label for="author">Author:</label>
        <input type="text" id="author" name="author" required>
    </div>
    
    <!-- content field container -->
    <div>
        <label for="content">Content:</label>
        <textarea id="content" name="content" rows="10" required 
                  placeholder="Write your blog post content here..."></textarea>
    </div>
    
    <!-- submit buttons container -->
    <div>
        <button type="submit">Publish Post</button>
        <a href="/blog">Cancel</a>
    </div>
</form>

<!-- blog features section -->
<div>
    <h3>Blog Features:</h3>
    <ul>
        <li>Create new posts with title, author, and content</li>
        <li>View all posts on the blog listing page</li>
        <li>Read individual posts with dynamic routing</li>
        <li>All data is stored in memory (resets on server restart)</li>
    </ul>
</div>